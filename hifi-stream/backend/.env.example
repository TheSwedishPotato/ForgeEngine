# Copy to .env and fill in. Every variable can also be set in the environment.

# --- required ---
DATABASE_URL=postgres://hifi:hifi@localhost:5432/hifi?sslmode=disable
# At least 32 random bytes, e.g. `openssl rand -hex 32`
JWT_SECRET=
# Optional; derived from JWT_SECRET when empty
STREAM_SIGNING_SECRET=

# --- server ---
PORT=8080
# Public base URL of this API (used to build signed stream links)
PUBLIC_URL=http://localhost:8080
# Comma-separated list of frontend origins
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=2048

# --- storage ---
# "local" (files on disk) or "r2" (Cloudflare R2)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./data/media
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# "redirect": players fetch directly from R2 with presigned URLs (zero egress fees)
# "proxy":    bytes flow through this server (you pay your host's bandwidth)
R2_DELIVERY=redirect

# --- money ---
MEMBERSHIP_PRICE_CENTS=1099
# Platform share of memberships and of direct artist subscriptions, in basis points (3000 = 30%)
MEMBERSHIP_FEE_BPS=3000
DIRECT_FEE_BPS=1000
# Enables one-click "payments" for local testing. Never enable in production.
DEV_FAKE_BILLING=false
# Protects POST /api/admin/payouts/run
ADMIN_TOKEN=
